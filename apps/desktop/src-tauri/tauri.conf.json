{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenVids",
  "identifier": "dev.openvids.desktop",
  "build": {
    "beforeDevCommand": "bun run dev:serve",
    "devUrl": "http://127.0.0.1:5190",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "publisher": "OpenVids",
    "copyright": "Copyright 2026 The OpenVids Authors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "licenseFile": "../../../LICENSE"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMzExNzI0MTYzQjVERUYKUldUdlhUc1dKQmN4d1NUMDg3UnpTT1gwNGpWSGpXbmJiQ0t4KzFDOWM0akt4YnRab2E2eC9BZGoK",
      "endpoints": ["https://github.com/bazodev/open-vids/releases/latest/download/latest.json"],
      "requireSignedVersion": true
    }
  }
}
